{
  "name": "starttrips",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "predev": "node scripts/generate-image-manifest.mjs",
    "build": "vite build",
    "prebuild": "node scripts/generate-image-manifest.mjs",
    "generate:manifest": "node scripts/generate-image-manifest.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:stats": "node scripts/check-stats.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:browser": "node tests/browser/verify.mjs",
    "verify": "npm run check:images -- --strict && npm run check:stats && npm run lint && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "image-size": "^2.0.4",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
