- --bg #FAF9F6 (page), --surface #FFFFFF, --text #151515, --muted #737373, --border #E8E6E0, --tint #F3F2EE (ticket caption areas, subtle fills), --footer #0E0E0E, --footer-muted #9A9A9A.
